{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowndevice:transition-receipt:v1alpha1",
  "title": "Known Device reference transition receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "scope", "deviceId", "outcome", "health", "activeGeneration", "previousRetired"],
  "properties": {
    "apiVersion": {"const": "knowndevice/v1alpha1"},
    "scope": {"const": "reference-device-path"},
    "deviceId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
    "operationId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "planDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "phase": {"enum": ["planned", "key-ready", "issue-intent", "issued", "register-intent", "registered", "verified", "activate-intent", "activated", "committed", "broker-retire-intent", "broker-retired", "ca-revoke-intent", "ca-revoked", "destroy-intent", "retired"]},
    "outcome": {"enum": ["idle", "running", "succeeded", "blocked", "unknown", "intervention_required"]},
    "health": {"enum": ["unknown", "application-confirmed"]},
    "activeGeneration": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "targetGeneration": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "previousRetired": {"type": "boolean"},
    "reason": {"enum": ["remote-outcome-unknown", "capability-unsupported", "authorization-or-application-denied", "generation-or-writer-conflict", "local-or-adapter-failure", "plan-expired-intervention-required"]}
  },
  "dependentRequired": {"operationId": ["planDigest", "phase", "targetGeneration"], "planDigest": ["operationId"], "phase": ["operationId"], "targetGeneration": ["operationId"]}
}
