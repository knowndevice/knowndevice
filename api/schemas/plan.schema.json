{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowndevice:plan:v1alpha1",
  "title": "Known Device bounded transition plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "operationId", "deviceId", "mode", "expectedGeneration", "targetGeneration", "targetSlot", "configDigest", "expiresAt", "digest"],
  "properties": {
    "apiVersion": {"const": "knowndevice/v1alpha1"},
    "operationId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "deviceId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
    "mode": {"enum": ["enroll", "rotate", "recover"]},
    "expectedGeneration": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "targetGeneration": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "targetSlot": {"enum": ["A", "B"]},
    "configDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "enroll"}}}, "then": {"properties": {"expectedGeneration": {"const": 0}}}, "else": {"properties": {"expectedGeneration": {"minimum": 1}}}}
  ]
}
