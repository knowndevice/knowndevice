{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowndevice:adapter-manifest:v1alpha1",
  "title": "Known Device generated reference adapter policy and selected manifest",
  "oneOf": [
    {
      "$ref": "#/$defs/template"
    },
    {
      "$ref": "#/$defs/manifest"
    }
  ],
  "$defs": {
    "schemaIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "const": "urn:knowndevice:process:0.1-alpha.1"
        },
        "version": {
          "const": "1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxLineBytes",
        "maxCSRBytes",
        "maxChainBytes",
        "maxCertificates",
        "maxDepth",
        "maxValues",
        "maxObjectFields",
        "maxArrayItems",
        "maxStringBytes",
        "maxInFlight",
        "maxRequests",
        "maxSignerCalls",
        "maxSignatureBytes",
        "maxDigestBytes",
        "maxStderrBytes",
        "maxTimeoutMillis"
      ],
      "properties": {
        "maxLineBytes": {
          "const": 1048576
        },
        "maxCSRBytes": {
          "const": 16384
        },
        "maxChainBytes": {
          "const": 65536
        },
        "maxCertificates": {
          "const": 8
        },
        "maxDepth": {
          "const": 32
        },
        "maxValues": {
          "const": 10000
        },
        "maxObjectFields": {
          "const": 64
        },
        "maxArrayItems": {
          "const": 256
        },
        "maxStringBytes": {
          "const": 262144
        },
        "maxInFlight": {
          "const": 1
        },
        "maxRequests": {
          "const": 4096
        },
        "maxSignerCalls": {
          "const": 32
        },
        "maxSignatureBytes": {
          "const": 512
        },
        "maxDigestBytes": {
          "const": 64
        },
        "maxStderrBytes": {
          "const": 1048576
        },
        "maxTimeoutMillis": {
          "const": 60000
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "policyDigest"
      ],
      "properties": {
        "id": {
          "enum": [
            "reference-generation-cn",
            "stable-device-cn"
          ]
        },
        "version": {
          "const": 1
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "name",
        "backend",
        "scope",
        "protocolVersion",
        "errorVersion",
        "schemas",
        "compositionId",
        "compositionVersion",
        "capabilities",
        "limits",
        "supportedProfiles",
        "permissions"
      ],
      "properties": {
        "apiVersion": {
          "const": "knowndevice-adapter/v1alpha1"
        },
        "kind": {
          "const": "template"
        },
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "backend": {
          "const": "profilehttp-reference"
        },
        "scope": {
          "const": "fixture-reference-composition"
        },
        "protocolVersion": {
          "const": "knowndevice-process/0.1-alpha.1"
        },
        "errorVersion": {
          "const": "knowndevice-process-errors/1"
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/schemaIdentity"
          }
        },
        "compositionId": {
          "const": "local-http-process-lab"
        },
        "compositionVersion": {
          "const": 1
        },
        "capabilities": {
          "const": [
            "application.activate",
            "application.activationStatus",
            "authority.import",
            "authority.issue",
            "authority.lookup",
            "authority.revocationStatus",
            "authority.revoke",
            "bounded-interval",
            "bounded-unknown-issuance",
            "clock.assess",
            "current-entitlement",
            "durable-activation-and-fresh-observation",
            "durable-deny-and-session-inventory",
            "entitlement.authorize",
            "exact-peer-binding",
            "explicit-access-observation",
            "platform.register",
            "platform.registrationStatus",
            "transport.probe",
            "withdrawal.status",
            "withdrawal.withdraw"
          ]
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "supportedProfiles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version",
                "policyDigest"
              ],
              "properties": {
                "id": {
                  "const": "reference-generation-cn"
                },
                "version": {
                  "const": 1
                },
                "policyDigest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version",
                "policyDigest"
              ],
              "properties": {
                "id": {
                  "const": "stable-device-cn"
                },
                "version": {
                  "const": 1
                },
                "policyDigest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ],
          "items": false
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "networkOriginsFrom",
            "filesystemRead",
            "filesystemWrite",
            "signerBroker"
          ],
          "properties": {
            "networkOriginsFrom": {
              "const": [
                "application",
                "control",
                "issuance",
                "transport"
              ]
            },
            "filesystemRead": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 0
            },
            "filesystemWrite": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 0
            },
            "signerBroker": {
              "const": true
            }
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "name",
        "backend",
        "scope",
        "protocolVersion",
        "errorVersion",
        "schemas",
        "compositionId",
        "compositionVersion",
        "capabilities",
        "limits",
        "artifactDigest",
        "snapshotDigest",
        "compositionDigest",
        "profile",
        "permissions"
      ],
      "properties": {
        "apiVersion": {
          "const": "knowndevice-adapter/v1alpha1"
        },
        "kind": {
          "const": "manifest"
        },
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "backend": {
          "const": "profilehttp-reference"
        },
        "scope": {
          "const": "fixture-reference-composition"
        },
        "protocolVersion": {
          "const": "knowndevice-process/0.1-alpha.1"
        },
        "errorVersion": {
          "const": "knowndevice-process-errors/1"
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/schemaIdentity"
          }
        },
        "compositionId": {
          "const": "local-http-process-lab"
        },
        "compositionVersion": {
          "const": 1
        },
        "capabilities": {
          "const": [
            "application.activate",
            "application.activationStatus",
            "authority.import",
            "authority.issue",
            "authority.lookup",
            "authority.revocationStatus",
            "authority.revoke",
            "bounded-interval",
            "bounded-unknown-issuance",
            "clock.assess",
            "current-entitlement",
            "durable-activation-and-fresh-observation",
            "durable-deny-and-session-inventory",
            "entitlement.authorize",
            "exact-peer-binding",
            "explicit-access-observation",
            "platform.register",
            "platform.registrationStatus",
            "transport.probe",
            "withdrawal.status",
            "withdrawal.withdraw"
          ]
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "artifactDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshotDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "compositionDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "networkOrigins",
            "filesystemRead",
            "filesystemWrite",
            "signerBroker"
          ],
          "properties": {
            "networkOrigins": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^https://[^/?#@\\s]+$"
              }
            },
            "filesystemRead": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 0
            },
            "filesystemWrite": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 0
            },
            "signerBroker": {
              "const": true
            }
          }
        }
      }
    }
  }
}
